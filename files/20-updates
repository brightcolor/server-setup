#!/usr/bin/env bash

set -u

if ! command -v apt-get >/dev/null 2>&1; then
    exit 0
fi

updates="$(apt list --upgradable 2>/dev/null | awk 'NR > 1 {count++} END {print count + 0}')"
security_updates="$(apt list --upgradable 2>/dev/null | awk '/-security/ {count++} END {print count + 0}')"

printf "%s updates to install.\n" "$updates"
printf "%s are security updates.\n\n" "$security_updates"
